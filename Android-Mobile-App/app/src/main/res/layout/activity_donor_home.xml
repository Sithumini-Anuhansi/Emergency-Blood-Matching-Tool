<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FAFAFA">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#1565C0"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="="
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">
                <TextView
                    android:id="@+id/tvDonorName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hello, Donor"
                    android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#BBDEFB" android:textSize="12sp"/>
            </LinearLayout>

            <Switch
                android:id="@+id/switchAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dashboard -->
                <LinearLayout
                    android:id="@+id/layoutDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <FrameLayout android:id="@+id/cardStatDonations"
                            android:layout_width="0dp" android:layout_height="100dp"
                            android:layout_weight="1"
                            android:background="#1565C0"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <View android:layout_width="60dp" android:layout_height="60dp"
                                android:background="@drawable/stat_circle"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="-20dp"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView android:id="@+id/tvStatDonations"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0" android:textColor="#FFFFFF"
                                    android:textSize="28sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Donations" android:textColor="#BBDEFB" android:textSize="12sp"
                                    android:textAllCaps="true" android:letterSpacing="0.05"/>
                            </LinearLayout>
                        </FrameLayout>

                        <FrameLayout android:id="@+id/cardStatPending"
                            android:layout_width="0dp" android:layout_height="100dp"
                            android:layout_weight="1"
                            android:background="#E65100"
                            android:layout_marginStart="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <View android:layout_width="60dp" android:layout_height="60dp"
                                android:background="@drawable/stat_circle"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="-20dp"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView android:id="@+id/tvStatPendingReqs"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0" android:textColor="#FFFFFF"
                                    android:textSize="28sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Pending" android:textColor="#FFE0B2" android:textSize="12sp"
                                    android:textAllCaps="true" android:letterSpacing="0.05"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp"
                        android:elevation="2dp">
                        <TextView android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Available" android:textSize="14sp" android:textColor="#388E3C"/>
                    </LinearLayout>

                    <Button android:id="@+id/btnPendingRequests"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Pending Requests"
                        android:backgroundTint="#1565C0" android:textColor="#FFFFFF"
                        android:padding="14dp"/>
                </LinearLayout>

                <!-- Requests cards -->
                <LinearLayout
                    android:id="@+id/layoutRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/listContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <Button android:id="@+id/btnBackFromRequests"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Back to Dashboard"
                        android:backgroundTint="#757575" android:textColor="#FFFFFF"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

                <!-- Text result -->
                <LinearLayout
                    android:id="@+id/layoutResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:id="@+id/txtResult"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:background="#FFFFFF"
                        android:padding="16dp" android:elevation="2dp"/>

                    <Button android:id="@+id/btnBackFromResult"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Back to Dashboard"
                        android:backgroundTint="#757575" android:textColor="#FFFFFF"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Drawer -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1565C0" android:padding="20dp" android:orientation="vertical">
            <TextView android:id="@+id/tvDrawerDonorName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Donor"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>

        <Button android:id="@+id/navDashboard"
            style="@style/DrawerItemStyle" android:text="Home"/>
        <Button android:id="@+id/btnPendingRequestsNav"
            style="@style/DrawerItemStyle" android:text="Pending Requests"/>
        <Button android:id="@+id/btnDonationHistory"
            style="@style/DrawerItemStyle" android:text="Donation History"/>
        <Button android:id="@+id/btnProfile"
            style="@style/DrawerItemStyle" android:text="Profile"/>
        <Button android:id="@+id/btnNotifications"
            style="@style/DrawerItemStyle" android:text="Notifications"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#E0E0E0" android:layout_marginVertical="4dp"/>

        <Button android:id="@+id/btnLogout"
            style="@style/DrawerItemStyle" android:text="Logout" android:textColor="#C62828"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
